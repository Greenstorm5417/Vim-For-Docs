{
  "manifest_version": 3,
  "name": "Vim-For-Docs",
  "description": "An implementation of Vim motions for Google Docs",
  "version": "3.0",
  "minimum_chrome_version": "97",
  "permissions": ["storage", "clipboardWrite"],
  "browser_specific_settings": {
    "gecko": {
      "id": "greenstorm@vimfordocs.org",
      "strict_min_version": "125.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "ui/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "js": [
        "config.js",
        "parser.js",
        "executor.js",
        "ui.js",
        "line-numbers.js",
        "content.js"
      ],
      "matches": [
        "https://docs.google.com/document/*",
        "https://docs.google.com/document/d/*",
        "https://docs.google.com/document/create*",
        "https://docs.google.com/document/u/*/create*",
        "https://docs.google.com/document/t/*",
        "https://docs.google.com/document/d/t/*"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["motions.json"],
      "matches": ["https://docs.google.com/*"]
    }
  ]
}
